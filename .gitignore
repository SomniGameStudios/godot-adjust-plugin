# Godot Adjust Plugin .gitignore

# OS
.DS_Store

# Godot
.godot/
*.uid

# Android build artifacts
platforms/android/.gradle/
platforms/android/build/
platforms/android/src/core/build/
platforms/android/local.properties
platforms/android/build.log

# iOS build artifacts
platforms/ios/.build/
platforms/ios/build/
platforms/ios/bin/
platforms/ios/.swiftpm/
platforms/ios/Package.resolved
platforms/ios/xcodebuild_output.txt
platforms/ios/include/
platforms/ios/include/godot/
platforms/bin/

# Godot editor generated
platforms/godot_editor/.godot/
platforms/godot_editor/android/
platforms/godot_editor/export_presets.cfg

# Binaries (generated by build scripts)
platforms/godot_editor/addons/adjust/android/bin/
platforms/godot_editor/ios/plugins/
*.aar
*.a
*.xcframework
*.zip

# IDE
.idea/
*.iml
.vscode/

# Local credentials
*credentials.json

# Documentation build output
site/
.cache/

# Local Test Projects and Exports
test_empty_project/
exports/

# Antigravity CLI
.antigravitycli/

# Kotlin local configurations
**/.*kotlin*/
**/.*Kotlin*/


