[gd_scene load_steps=2 format=3 uid="uid://sample_scene"]

[ext_resource type="Script" path="res://sample.gd" id="1_script"]

[node name="Sample" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="ColorRect" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.1, 0.1, 0.12, 1)

[node name="ConfirmationDialog" type="ConfirmationDialog" parent="."]
title = "Warning: Irreversible Action"
initial_position = 2
size = Vector2i(400, 150)
dialog_text = "Calling GDPR Forget Me permanently opts out this device. This cannot be undone. Are you sure?"
dialog_autowrap = true

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 13
anchor_left = 0.5
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -200.0
offset_right = 200.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 20
alignment = 1

[node name="Title" type="Label" parent="VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "ADJUST SDK"
horizontal_alignment = 1

[node name="StatusLabel" type="Label" parent="VBoxContainer"]
layout_mode = 2
text = "Status: Not Initialized"
horizontal_alignment = 1

[node name="HSeparator" type="HSeparator" parent="VBoxContainer"]
layout_mode = 2

[node name="Initialize" type="Button" parent="VBoxContainer"]
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
text = "Initialize SDK"

[node name="TrackEvent" type="Button" parent="VBoxContainer"]
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
text = "Track Simple Event"

[node name="TrackRevenue" type="Button" parent="VBoxContainer"]
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
text = "Track Revenue (0.99 USD)"

[node name="ForgetMe" type="Button" parent="VBoxContainer"]
self_modulate = Color(0.9, 0.3, 0.3, 1)
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
text = "GDPR Forget Me"

[node name="RequestATT" type="Button" parent="VBoxContainer"]
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
text = "Request ATT (iOS)"

[node name="GetAttribution" type="Button" parent="VBoxContainer"]
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
text = "Get Attribution"

[node name="TrackAdRevenue" type="Button" parent="VBoxContainer"]
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
text = "Track Ad Revenue (0.45 USD)"

[node name="ConsentTrue" type="Button" parent="VBoxContainer"]
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
text = "GDPR Consent: YES"

[node name="ConsentFalse" type="Button" parent="VBoxContainer"]
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
text = "GDPR Consent: NO"

[node name="HSeparator2" type="HSeparator" parent="VBoxContainer"]
layout_mode = 2

[node name="ScrollContainer" type="ScrollContainer" parent="VBoxContainer"]
custom_minimum_size = Vector2(0, 150)
layout_mode = 2

[node name="LogLabel" type="Label" parent="VBoxContainer/ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 12
text = "Logs:"
autowrap_mode = 3

[connection signal="pressed" from="VBoxContainer/Initialize" to="." method="_on_initialize_pressed"]
[connection signal="pressed" from="VBoxContainer/TrackEvent" to="." method="_on_track_event_pressed"]
[connection signal="pressed" from="VBoxContainer/TrackRevenue" to="." method="_on_track_revenue_pressed"]
[connection signal="pressed" from="VBoxContainer/ForgetMe" to="." method="_on_forget_me_pressed"]
[connection signal="pressed" from="VBoxContainer/RequestATT" to="." method="_on_request_att_pressed"]
[connection signal="pressed" from="VBoxContainer/GetAttribution" to="." method="_on_get_attribution_pressed"]
[connection signal="pressed" from="VBoxContainer/TrackAdRevenue" to="." method="_on_track_ad_revenue_pressed"]
[connection signal="pressed" from="VBoxContainer/ConsentTrue" to="." method="_on_consent_true_pressed"]
[connection signal="pressed" from="VBoxContainer/ConsentFalse" to="." method="_on_consent_false_pressed"]
[connection signal="confirmed" from="ConfirmationDialog" to="." method="_on_forget_me_confirmed"]


